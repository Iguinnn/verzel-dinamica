{
  "name": "@parking/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "tsx --test src/app.test.ts src/auth.test.ts src/reservations.test.ts src/waitlist.test.ts",
    "test:integration": "tsx --test src/waitlist.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@parking/contracts": "*",
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
